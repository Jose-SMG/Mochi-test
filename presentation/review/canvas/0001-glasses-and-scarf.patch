+    drawOutfitFront(ctx, "scarf", H, st);
+    drawOutfitFront(ctx, "roundGlasses", H, st);
+    return;
+  }
   if (outfit === "none" || outfit === "bunnyEars") return;
   if (ON_FACE.has(outfit) && faceTurnedAway(H)) return;
   const alpha = layerAlpha(st);
